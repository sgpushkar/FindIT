<%-- Possible-match list. Expects "matches" (List<Match>) in scope. --%>
<div class="matches">
    <c:forEach var="m" items="${matches}">
        <div class="match">
            <div class="match-head">
                <span class="eyebrow accent">Possible match found</span>
                <span class="match-score">${m.score}% match</span>
            </div>
            <div class="match-body">
                <div>
                    <span class="label">Your ${fn:toLowerCase(m.source.type)} item</span>
                    <strong><c:out value="${m.source.itemName}" /></strong>
                </div>
                <div>
                    <span class="label">Possible ${fn:toLowerCase(m.candidate.type)} item</span>
                    <strong><c:out value="${m.candidate.itemName}" /></strong>
                </div>
                <div>
                    <span class="label">Location</span>
                    <strong><c:out value="${m.candidate.location}" /></strong>
                </div>
            </div>
            <div class="meter" aria-hidden="true"><span style="width: ${m.score}%"></span></div>
            <a class="link" href="${ctx}/item?id=${m.candidate.id}">View match &rarr;</a>
        </div>
    </c:forEach>
</div>
